+{
+  // VBRI 固定在 MPEG 音频头结束后 32 字节，即帧起点 + 4 + 32。
+  static constexpr size_t kVbriOffset = 4u + 32u;
+  static constexpr size_t kVbriFixedBytes = 26u;
+  static constexpr uint16_t kMaxVbriEntries = 1024u;
