+namespace {
+
+static constexpr size_t kFingerprintSampleBytes = 512;
+
+struct CachedFingerprintV1 {
+    String path;
+    StorageFileFingerprintV1 fingerprint;
+    bool ok = false;
+};
+
+struct IncrementalScanContextV3 {
