+    s_cover_panel_trig_lut[deg].cos1024 = (int16_t)lroundf(cosf(rad) * 1024.0f);
+    s_cover_panel_trig_lut[deg].sin1024 = (int16_t)lroundf(sinf(rad) * 1024.0f);
